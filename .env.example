# ---------------------------------------------------------------------------
# Gambit3D environment configuration
# Copy to `.env` and adjust. NEVER commit a real `.env`.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
# Port the HTTP + WebSocket server listens on.
PORT=8787

# Interface to bind. Use 127.0.0.1 for local-only.
# Use 0.0.0.0 to accept connections from other devices on your Wi-Fi/LAN.
HOST=127.0.0.1

# "development" | "production" | "test"
NODE_ENV=development

# --- Security ---------------------------------------------------------------
# Comma-separated list of allowed browser Origins for CORS + Socket.IO.
# Use "*" ONLY for LAN/dev. In production list your real origins.
# Example: https://chess.example.com,https://www.chess.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# When true (recommended for LAN mode) private-network origins such as
# http://192.168.x.x:5173 are also accepted automatically.
ALLOW_LAN_ORIGINS=true

# Server-side secret used to derive HMACs for reconnection tokens.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# If unset, a random secret is generated at boot (sessions will not survive a restart).
SESSION_SECRET=

# Trust X-Forwarded-For headers (set to true only behind a trusted reverse proxy).
TRUST_PROXY=false

# --- Database ---------------------------------------------------------------
# SQLite file path (relative paths resolve against the server package root).
# Use ":memory:" for an ephemeral database.
DATABASE_PATH=./data/gambit3d.db

# --- Room lifecycle ---------------------------------------------------------
# Milliseconds an empty room is kept before cleanup.
ROOM_EMPTY_TTL_MS=300000
# Milliseconds a room may live in total before forced expiry.
ROOM_MAX_AGE_MS=86400000
# How often the cleanup sweep runs.
ROOM_SWEEP_INTERVAL_MS=60000
# Grace period a disconnected player keeps their seat before abandonment.
DISCONNECT_GRACE_MS=90000
# Maximum concurrent rooms per server instance.
MAX_ROOMS=500
# Maximum rooms a single IP may create per hour.
MAX_ROOMS_PER_IP_PER_HOUR=30

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_CHAT_PER_MIN=25
RATE_LIMIT_MOVES_PER_MIN=300
RATE_LIMIT_JOIN_PER_MIN=20
RATE_LIMIT_CREATE_PER_MIN=6
RATE_LIMIT_HTTP_PER_MIN=240

# --- Level editor -----------------------------------------------------------
# Lets the in-app level editor (/editor) write scene layouts back to disk.
# Defaults to ON in development and OFF in production - a public deployment has
# no business writing files from a web request. The editor page itself always
# works and can export a layout as a download either way.
LEVEL_EDITOR=

# Where those layouts are written. Relative paths resolve from the repo root.
# Default: packages/client/public/layouts
LAYOUT_DIR=

# --- Client (Vite) ----------------------------------------------------------
# Where the browser should reach the game server.
# Leave EMPTY to auto-derive from the page origin (correct for LAN + single-origin
# production deploys). Set explicitly when the client is hosted separately.
VITE_SERVER_URL=

# Vite dev server port.
VITE_PORT=5173
